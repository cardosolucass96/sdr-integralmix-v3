# Configuracao de bootstrap.
# Copie para .env apenas para desenvolvimento local. A plataforma de
# deploy deve injetar os mesmos valores como secrets. Todo comportamento do SDR
# e configurado em /settings; o catalogo v2 abaixo e uma dependencia da integracao.

# Obrigatorio em producao.
DATABASE_URL=
OPENAI_API_KEY=
PIPEFACIL_API_KEY=
PIPEFACIL_WEBHOOK_SIGNATURE_SECRET=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
ELEVENLABS_API_KEY=

# Gere com: make settings-key
SETTINGS_ADMIN_KEY_HASH=
SETTINGS_SESSION_SECRET=

# V2: credencial independente de um membro humano/servico para avisos aos supervisores.
# Nunca reutilize PIPEFACIL_API_KEY aqui. Nao exponha este valor ao modelo.
PIPEFACIL_SUPERVISOR_API_KEY=
# Snapshot JSON dos funis/etapas autorizados para encaminhamento (nao e segredo).
# O agente v2 nao pode listar funis pela API publica generica.
PIPEFACIL_HANDOFF_PIPELINES=[]
